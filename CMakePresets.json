{
  "version": 6,
  "configurePresets": [
    {
      "name": "ucrt64-debug",
      "displayName": "UCRT64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ucrt64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/cc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
