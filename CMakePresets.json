{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux + Ninja (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux + Ninja (Release)",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ucrt64-debug",
      "displayName": "MSYS2 UCRT64 + Ninja (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ucrt64-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}",
        "MSYSTEM": "UCRT64"
      }
    },
    {
      "name": "ucrt64-release",
      "displayName": "MSYS2 UCRT64 + Ninja (Release)",
      "inherits": "ucrt64-debug",
      "binaryDir": "${sourceDir}/build-ucrt64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vs2022-x64-debug",
      "displayName": "VS 2022 x64 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64-debug",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2022-x64-release",
      "displayName": "VS 2022 x64 Release",
      "inherits": "vs2022-x64-debug",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64-release"
    }
  ],
  "buildPresets": [
    {
      "name": "build-linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "build-linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "build-ucrt64-debug",
      "configurePreset": "ucrt64-debug"
    },
    {
      "name": "build-ucrt64-release",
      "configurePreset": "ucrt64-release"
    },
    {
      "name": "build-vs2022-x64-debug",
      "configurePreset": "vs2022-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-vs2022-x64-release",
      "configurePreset": "vs2022-x64-release",
      "configuration": "Release"
    }
  ]
}